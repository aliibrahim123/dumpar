import math.nb { 
	nb, zeros15, a, b, c, d, e, f, zeros8, zeros7, zeros12, zeros13, zeros14, zero, nb2bin, bin2nb,
	u6_u4u2, 0000, 0001, b0, low2, low3, b3, high2, high3, mid2, b2, b1, n8_nb
